{
  "expo": {
    "name": "the-skolar",
    "slug": "the-skolar",
    "scheme": "acme",
    "splash": {
      "image": "src/assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#194F92"
    },
    "web": {
      "bundler": "metro"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "12310fe5-bccd-4816-9f2b-be383644567b"
      }
    },
    "owner": "codevamp",
    "updates": {
      "url": "https://u.expo.dev/12310fe5-bccd-4816-9f2b-be383644567b"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "com.codevamp.theskolar",
      "userInterfaceStyle": "automatic"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
